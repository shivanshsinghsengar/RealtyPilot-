# RealtyPilot Environment Variables

# Next.js App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Public Client Keys - Safe for Browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase (Admin / Service Role - STRICTLY SERVER-ONLY, NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Gemini API (STRICTLY SERVER-ONLY)
GEMINI_API_KEY="your-gemini-api-key"
# Gemini model name — use gemini-3.8-flash (recommended, GA October 2026)
GEMINI_MODEL="gemini-3.8-flash"

# Meta WhatsApp Cloud API (STRICTLY SERVER-ONLY)
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-business-account-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-system-user-access-token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-custom-verify-token-random-string"
WHATSAPP_APP_SECRET="your-meta-app-secret-for-hmac-verification"

# Google Places API (Phase 7 - Lead Discovery, SERVER-ONLY)
GOOGLE_PLACES_API_KEY="your-google-places-api-key"

# Cron Secret (for automated reminder & follow-up jobs)
CRON_SECRET="your-random-32-character-secret-key-here"
